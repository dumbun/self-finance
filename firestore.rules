rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Lender-isolated financial data (customers, items, transactions, payments, history, loan_verifications)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Collection group query rule for customer portal read access
    match /{path=**}/customers/{customerId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/transactions/{transactionId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/items/{itemId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/payments/{paymentId} {
      allow read: if request.auth != null;
    }

    // 3. Customer portal OTP authentication sessions
    match /customer_portal_sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}
