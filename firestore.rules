rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Lender-isolated financial data (customers, items, transactions, payments, history, loan_verifications)
    //    Only the owning lender (authenticated via Firebase Auth) can read or write their own data.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Collection group query rules for customer portal read access.
    //    Required for borrowers to look up their own loan data by phone number.
    //    Restricted to non-deleted documents only. Soft-deleted records are never exposed.
    //    NOTE: For stronger isolation, migrate portal data fetching to a Cloud Function
    //    that validates the portal token server-side before returning data.
    match /{path=**}/customers/{customerId} {
      allow read: if !('deleted_at' in resource.data) || resource.data.deleted_at == null;
    }
    match /{path=**}/transactions/{transactionId} {
      allow read: if !('deleted_at' in resource.data) || resource.data.deleted_at == null;
    }
    match /{path=**}/items/{itemId} {
      allow read: if !('deleted_at' in resource.data) || resource.data.deleted_at == null;
    }
    match /{path=**}/payments/{paymentId} {
      allow read: if !('deleted_at' in resource.data) || resource.data.deleted_at == null;
    }

    // 3. Customer portal OTP authentication sessions.
    //    - create: Customers create sessions to request an OTP or verify Phone Auth.
    //    - read, update: Allowed if the session contains a valid phone_number (rate-limiting & preventing blank enumerations).
    //    - delete: Restricted to authenticated lenders.
    match /customer_portal_sessions/{sessionId} {
      allow create: if request.resource.data.phone_number is string
                    && request.resource.data.phone_number.size() > 0;

      allow read, update: if resource.data.phone_number != null;

      allow delete: if request.auth != null;
    }
  }
}
