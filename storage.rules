rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Isolated storage path per lender: /{userId}/{folder}/{filename}
    // Ensures users can only upload, read, and delete their own customer photos, proofs, and transaction signatures
    match /{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
